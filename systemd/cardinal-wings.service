[Unit]
Description=cardinal-wings REST API daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cardinal-wings --config /etc/cardinal-wings/config.toml
Restart=on-failure
RestartSec=5s
# Recommended: run as an unprivileged user that can read the config.
# The daemon needs to reach cardinal's data dir; set User=cardinal if needed.
# User=cardinal
Environment=CARDINAL_DATA_DIR=/root/.cardinal
# Реестровая политика: cardinal принимает pull только из allowlist (дефолт —
# Docker Hub, ghcr.io, quay.io, gcr.io). Флаг наследуется запускаемым из
# wings процессом cardinal serve. Свой реестр: cardinal registry allowlist add.
Environment=CARDINAL_REGISTRY_STRICT=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target