[Unit]
Description=cardinal-wings REST API daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cardinal-wings --config /etc/cardinal-wings/config.toml
Restart=on-failure
RestartSec=5s
# Каталог состояния wings: аудит-лог, sftp-users.json, задачи, бэкапы.
# Без него systemd работает из /, и эти файлы появляются в корне ФС.
Environment=WINGS_DATA_DIR=/var/lib/cardinal-wings
WorkingDirectory=/var/lib/cardinal-wings
# Данные рантайма cardinal: wings управляет контейнерами через него.
Environment=CARDINAL_DATA_DIR=/root/.cardinal
# Реестровая политика: cardinal принимает pull только из allowlist (дефолт —
# Docker Hub, ghcr.io, quay.io, gcr.io). Флаг наследуется запускаемым из
# wings процессом cardinal serve. Свой реестр: cardinal registry allowlist add.
Environment=CARDINAL_REGISTRY_STRICT=1
# Умеренное ужесточение: сервису нужен root (управление контейнерами,
# loop-устройства, iptables), поэтому защищаем то, что можно безопасно.
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=false
ReadWritePaths=/var/lib/cardinal-wings /root/.cardinal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
